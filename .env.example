NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
DEMO_MODE=true

# Required for production persistence.
POSTGRES_URL=

# Required for encrypted OAuth refresh tokens and IMAP credentials.
TOKEN_ENCRYPTION_KEY=replace-with-32+-char-secret

# Single-user demo access gate. Leave blank for local demo mode.
APP_ACCESS_TOKEN=

# Gmail OAuth app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Azure app.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Anthropic production AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
