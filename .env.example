# Public base URL. On Vercel, $VERCEL_URL is used automatically when this is
# unset; set it explicitly for a stable/custom domain. It defines the OAuth
# redirect URI: <NEXT_PUBLIC_APP_URL>/api/connect/gmail/callback.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
DEMO_MODE=true

# Required for production persistence.
POSTGRES_URL=

# Encrypts OAuth refresh tokens, IMAP credentials, and the per-browser
# bring-your-own-credentials cookie. Set a real 32+ char secret on any shared
# deployment; without it a known default key is used (local demo only).
TOKEN_ENCRYPTION_KEY=replace-with-32+-char-secret

# Single-user demo access gate. Leave blank for local demo mode.
APP_ACCESS_TOKEN=

# Gmail OAuth app. OPTIONAL: when unset, a visitor can supply their own client
# ID/secret in-app via the setup screen (stored encrypted, per browser). If set
# here, the Google Cloud Console OAuth client's Authorized redirect URI must
# exactly match <NEXT_PUBLIC_APP_URL>/api/connect/gmail/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Azure app. Server-environment only (no in-app entry).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Anthropic production AI. OPTIONAL: when unset, AI uses the deterministic
# fallback, or a visitor can supply their own key in-app via the setup screen.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
